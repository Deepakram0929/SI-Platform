# ------------------------------------------------------------
# MULTI-NAMESPACE FILTER FORMULA HELPER
# ------------------------------------------------------------
#
# The Summary sheet's Namespace Filter cell ($B$5) can now hold either:
#   - "ALL SELECTED"                     -> aggregate every namespace
#   - a single namespace, e.g. "ns-one"  -> that namespace only
#   - a comma-separated list, e.g.
#         "ns-one, ns-two, ns-three"      -> just those namespaces
#
# Namespace Metrics!A holds exactly one namespace per row, so matching a
# comma-separated filter list requires a substring/token match rather than a
# straight equality (SUMIFS can't do this on its own), hence SUMPRODUCT +
# SEARCH wrapped with leading/trailing commas so "ns-1" never matches inside
# "ns-10".
#
NAMESPACE_METRICS_MAX_ROW = 5000


def _multi_namespace_sum_formula(metric_column_letter, resource_filter_expr, filter_cell="$B$5"):
    """Build a SUMPRODUCT formula that sums a Namespace Metrics column,
    filtered to rows whose Namespace appears in a comma-separated list
    typed into `filter_cell` (or ALL rows when `filter_cell` is
    "ALL SELECTED")."""

    metric_range = (
        f"'Namespace Metrics'!${metric_column_letter}$2:"
        f"${metric_column_letter}${NAMESPACE_METRICS_MAX_ROW}"
    )
    namespace_range = (
        f"'Namespace Metrics'!$A$2:$A${NAMESPACE_METRICS_MAX_ROW}"
    )

    all_expression = f"SUMPRODUCT(({resource_filter_expr})*{metric_range})"

    selected_expression = (
        "SUMPRODUCT("
        f"({resource_filter_expr})*"
        f"ISNUMBER(SEARCH(\",\"&{namespace_range}&\",\","
        f"\",\"&SUBSTITUTE(TRIM({filter_cell}),\" \",\"\")&\",\"))*"
        f"{metric_range})"
    )

    return f'=IF({filter_cell}="ALL SELECTED",{all_expression},{selected_expression})'


