def _status_counts(rows):
    """Return SAME/DIFF/MISSING/DESTINATION ONLY counts for comparison rows."""
    counts = {
        "SAME": 0,
        "DIFF": 0,
        "MISSING": 0,
        "DESTINATION ONLY": 0,
    }
    for row in rows or []:
        status = str(row.get("Status", "")).strip().upper()
        if status in counts:
            counts[status] += 1
    counts["TOTAL"] = sum(counts.values())
    counts["MATCH_PCT"] = (
        counts["SAME"] / counts["TOTAL"]
        if counts["TOTAL"] else 1.0
    )
    counts["DIFFERENCE_PCT"] = 1.0 - counts["MATCH_PCT"]
    return counts


def _resource_comparison_rows(source_rows, destination_rows, resource_name):
    """Build comparable rows for every supported resource.

    Workloads are intentionally compared ONLY by Deployment name.
    Images continue to use workload/container as their comparison key.
    """

    if resource_name == "Workloads":
        # --------------------------------------------------------
        # WORKLOADS = DEPLOYMENT NAMES ONLY
        # --------------------------------------------------------
        # Ignore StatefulSets, DaemonSets, containers and images.
        # The UI option remains "Workloads".
        source_deployments = {}
        destination_deployments = {}

        for row in source_rows or []:
            if str(row.get("Workload Type", "")).strip() != "Deployment":
                continue

            namespace = str(row.get("Namespace", "") or "").strip()
            deployment_name = str(row.get("Workload", "") or "").strip()

            if not namespace or not deployment_name:
                continue

            key = (namespace, deployment_name)
            source_deployments[key] = {
                "Namespace": namespace,
                "Deployment Name": deployment_name,
            }

        for row in destination_rows or []:
            if str(row.get("Workload Type", "")).strip() != "Deployment":
                continue

            namespace = str(row.get("Namespace", "") or "").strip()
            deployment_name = str(row.get("Workload", "") or "").strip()

            if not namespace or not deployment_name:
                continue

            key = (namespace, deployment_name)
            destination_deployments[key] = {
                "Namespace": namespace,
                "Deployment Name": deployment_name,
            }

        return compare_rows(
            list(source_deployments.values()),
            list(destination_deployments.values()),
            ["Namespace", "Deployment Name"],
        )

    key_map = {
        "Images": ["Namespace", "Workload Type", "Workload", "Container"],
        "ConfigMaps": ["Namespace", "ConfigMap", "Key"],
        "Secrets": ["Namespace", "Secret", "Key"],
        "Ingress": ["Namespace", "Ingress", "Path", "Service", "Port"],
        "Volumes": ["Namespace", "Workload Type", "Workload", "Volume"],
        "PVC": ["Namespace", "PVC"],
    }

    return compare_rows(
        source_rows or [],
        destination_rows or [],
        key_map[resource_name],
    )


