def get_namespaces(core_api):

    response = core_api.list_namespace(
        _request_timeout=30
    )

    return sorted(
        [
            item.metadata.name
            for item in response.items
            if item.metadata
            and item.metadata.name
        ],
        key=str.lower,
    )


