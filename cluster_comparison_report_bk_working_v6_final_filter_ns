def _add_namespace_filter(workbook, namespaces, metrics):
    """Create a dedicated native Excel multi-namespace filter sheet.

    The Summary UI remains unchanged. Summary!C5 is a compact Filter button
    that opens this sheet. The Namespace column has Excel's normal checkbox
    filter (Select All + individual namespaces). Filtering the rows changes
    the SUBTOTAL visibility helper and therefore the Summary formulas.
    """
    sheet_name = "Namespace Filter"
    if sheet_name in workbook.sheetnames:
        del workbook[sheet_name]

    ws = workbook.create_sheet(sheet_name)
    styles = _excel_styles()

    values = sorted(
        {str(n).strip() for n in (namespaces or []) if str(n).strip()},
        key=str.lower,
    )

    headers = [
        "Namespace", "Visible",
        "Images Source", "Images Destination", "Images Same",
        "Images Different", "Images Missing", "Images Destination Only",
        "ConfigMaps Source", "ConfigMaps Destination", "ConfigMaps Same",
        "ConfigMaps Different", "ConfigMaps Missing",
        "ConfigMaps Destination Only",
    ]

    for col, header in enumerate(headers, start=1):
        cell = ws.cell(1, col, header)
        cell.fill = styles["header_fill"]
        cell.font = styles["header_font"]
        cell.border = styles["border"]
        cell.alignment = Alignment(
            horizontal="center", vertical="center", wrap_text=True
        )

    metric_map = {}
    for row in metrics or []:
        ns = str(row.get("Namespace", "")).strip()
        resource = str(row.get("Resource", "")).strip()
        if ns and resource in {"Images", "ConfigMaps"}:
            metric_map[(ns, resource)] = row

    for row_idx, namespace in enumerate(values, start=2):
        ws.cell(row_idx, 1, namespace)
        ws.cell(row_idx, 2, f"=SUBTOTAL(103,$A{row_idx})")

        image = metric_map.get((namespace, "Images"), {})
        config = metric_map.get((namespace, "ConfigMaps"), {})

        image_vals = [
            image.get("Source Count", 0),
            image.get("Destination Count", 0),
            image.get("Same", 0),
            image.get("Different", 0),
            image.get("Missing", 0),
            image.get("Destination Only", 0),
        ]
        config_vals = [
            config.get("Source Count", 0),
            config.get("Destination Count", 0),
            config.get("Same", 0),
            config.get("Different", 0),
            config.get("Missing", 0),
            config.get("Destination Only", 0),
        ]

        for col, value in enumerate(image_vals, start=3):
            ws.cell(row_idx, col, value or 0)
        for col, value in enumerate(config_vals, start=9):
            ws.cell(row_idx, col, value or 0)

        for col in range(1, 15):
            ws.cell(row_idx, col).border = styles["border"]

    last_row = max(2, len(values) + 1)

    if values:
        table = Table(
            displayName="NamespaceSelectionTable",
            ref=f"A1:N{last_row}",
        )
        table.tableStyleInfo = TableStyleInfo(
            name="TableStyleMedium2",
            showFirstColumn=False,
            showLastColumn=False,
            showRowStripes=True,
            showColumnStripes=False,
        )
        ws.add_table(table)

    # Keep only Namespace visible. The remaining columns are calculation
    # helpers and should never alter the Summary UI.
    for col in range(2, 15):
        ws.column_dimensions[get_column_letter(col)].hidden = True

    ws.column_dimensions["A"].width = 36
    ws.freeze_panes = "A2"
    ws.sheet_view.showGridLines = False
    ws.sheet_properties.pageSetUpPr.fitToPage = True
    ws.page_setup.orientation = "landscape"
    ws.page_setup.fitToWidth = 1
    ws.page_setup.fitToHeight = 0

    note_row = last_row + 2
    ws.cell(
        note_row,
        1,
        "Use the filter arrow in the Namespace header to check/uncheck "
        "multiple namespaces. Return to Summary to see the updated totals.",
    )
    ws.merge_cells(
        start_row=note_row,
        start_column=1,
        end_row=note_row + 1,
        end_column=6,
    )
    ws.cell(note_row, 1).font = Font(italic=True, color="666666")
    ws.cell(note_row, 1).alignment = Alignment(
        wrap_text=True,
        vertical="top",
    )

    return {
        "first_row": 2,
        "last_row": last_row,
        "visibility_col": "B",
        "images_cols": ["C", "D", "E", "F", "G", "H"],
        "configmaps_cols": ["I", "J", "K", "L", "M", "N"],
    }

