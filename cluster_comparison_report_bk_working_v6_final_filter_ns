def _add_deployment_comparison_sheet(workbook, source_rows, destination_rows):
    """Create Workloads sheet using only deployment names."""
    if "Workloads" in workbook.sheetnames:
        del workbook["Workloads"]

    ws = workbook.create_sheet("Workloads")
    styles = _excel_styles()

    headers = [
        "Namespace",
        "Deployment Name",
        "Deployment Name Source",
        "Deployment Name Destination",
        "Status",
    ]
    ws.append(headers)

    source = {}
    destination = {}

    for row in source_rows or []:
        if str(row.get("Workload Type", "")).strip().lower() != "deployment":
            continue
        ns = str(row.get("Namespace", "") or "").strip()
        name = str(row.get("Workload", "") or "").strip()
        if name:
            source.setdefault(ns, set()).add(name)

    for row in destination_rows or []:
        if str(row.get("Workload Type", "")).strip().lower() != "deployment":
            continue
        ns = str(row.get("Namespace", "") or "").strip()
        name = str(row.get("Workload", "") or "").strip()
        if name:
            destination.setdefault(ns, set()).add(name)

    for ns in sorted(set(source) | set(destination), key=str.lower):
        names = sorted(
            source.get(ns, set()) | destination.get(ns, set()),
            key=str.lower,
        )
        for name in names:
            in_source = name in source.get(ns, set())
            in_destination = name in destination.get(ns, set())

            if in_source and in_destination:
                status = "SAME"
            elif in_source:
                status = "MISSING"
            else:
                status = "DESTINATION ONLY"

            ws.append([
                ns,
                name,
                name if in_source else "",
                name if in_destination else "",
                status,
            ])

    for cell in ws[1]:
        cell.fill = styles["header_fill"]
        cell.font = styles["header_font"]
        cell.border = styles["border"]
        cell.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)

    ws.row_dimensions[1].height = 34

    for r in range(2, ws.max_row + 1):
        for c in ws[r]:
            c.border = styles["border"]
            c.alignment = Alignment(vertical="top", wrap_text=True)
        if r % 2 == 0:
            for c in ws[r]:
                c.fill = PatternFill("solid", fgColor="F8FBFF")
        _apply_status(ws.cell(r, 5), ws.cell(r, 5).value, styles)

    if ws.max_row >= 2:
        ws.auto_filter.ref = ws.dimensions

    ws.freeze_panes = "A2"
    ws.sheet_view.showGridLines = False
    ws.column_dimensions["A"].width = 28
    ws.column_dimensions["B"].width = 40
    ws.column_dimensions["C"].width = 40
    ws.column_dimensions["D"].width = 42
    ws.column_dimensions["E"].width = 24
    ws.sheet_properties.pageSetUpPr.fitToPage = True
    ws.page_setup.orientation = "landscape"
    ws.page_setup.fitToWidth = 1
    ws.page_setup.fitToHeight = 0
    ws.print_title_rows = "1:1"
    return ws

def _add_action_sheet(workbook, name, rows, title, description):
    ws = workbook.create_sheet(name)
    styles = _excel_styles()
    _add_title(ws, title, description, max(6, len(rows[0]) if rows else 6))
    if not rows:
        ws.cell(4, 1, "No items found.")
        ws.cell(4, 1).font = Font(bold=True, color="548235")
        ws.sheet_view.showGridLines = False
        return ws
    headers = list(rows[0].keys())
    header_row = 4
    for col, header in enumerate(headers, 1):
        c = ws.cell(header_row, col, header)
        c.fill = styles["header_fill"]
        c.font = styles["header_font"]
        c.border = styles["border"]
        c.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
    for r_idx, row in enumerate(rows, start=header_row + 1):
        for c_idx, header in enumerate(headers, 1):
            c = ws.cell(r_idx, c_idx, _excel_safe_value(row.get(header, "")))
            c.border = styles["border"]
            c.alignment = Alignment(vertical="top", wrap_text=True)
            if r_idx % 2 == 0:
                c.fill = PatternFill("solid", fgColor="F8FBFF")
        status_col = next((i for i, h in enumerate(headers, 1) if str(h).lower() == "status"), None)
        if status_col:
            _apply_status(ws.cell(r_idx, status_col), ws.cell(r_idx, status_col).value, styles)
    ws.freeze_panes = "A5"
    ws.auto_filter.ref = f"A{header_row}:{get_column_letter(len(headers))}{ws.max_row}"
    ws.sheet_view.showGridLines = False
    ws.page_setup.orientation = "landscape"
    ws.page_setup.fitToWidth = 1
    ws.page_setup.fitToHeight = 0
    ws.sheet_properties.pageSetUpPr.fitToPage = True
    ws.print_title_rows = f"1:{header_row}"
    for idx, header in enumerate(headers, 1):
        h = str(header).lower()
        width = 24
        if "namespace" in h:
            width = 26
        elif "value" in h or "image" in h:
            width = 60
        elif "key" in h:
            width = 40
        elif "workload" in h or "configmap" in h or "secret" in h:
            width = 34
        elif "status" in h:
            width = 22
        ws.column_dimensions[get_column_letter(idx)].width = width
    return ws


def _build_action_rows(comparison_rows, action_type):
    """Return only rows needed by an action sheet."""
    if action_type == "MISSING":
        wanted = {"MISSING"}
    elif action_type == "DIFF":
        wanted = {"DIFF"}
    else:
        wanted = {"DESTINATION ONLY"}
    return [row for row in comparison_rows if str(row.get("Status", "")).upper() in wanted]


def _make_resource_stats(source, destination, selected_resources):
    """Calculate counts and percentages for the Summary sheet."""
    stats = {}
    for resource in selected_resources:
        if resource == "Images":
            source_rows = source.get("workloads", [])
            destination_rows = destination.get("workloads", [])
        elif resource == "PVC":
            source_rows = source.get("pvcs", [])
            destination_rows = destination.get("pvcs", [])
        else:
            key = resource.lower()
            source_rows = source.get(key, [])
            destination_rows = destination.get(key, [])
        compared = _resource_comparison_rows(source_rows, destination_rows, resource)
        counts = _status_counts(compared)
        counts["SOURCE_COUNT"] = len(source_rows)
        counts["DESTINATION_COUNT"] = len(destination_rows)
        stats[resource] = counts
    return stats



def _add_missing_in_destination_sheet(workbook, comparison, selected_resources):
    """
    Create one consolidated worksheet listing resources that exist in the
    source environment but are missing in the destination environment.

    Layout:
        Namespace | Resource | Resource Name | Details | Status

    Rows are grouped by namespace and resource.
    """
    sheet_name = "Missing in Destination"

    if sheet_name in workbook.sheetnames:
        del workbook[sheet_name]

    ws = workbook.create_sheet(sheet_name)
    styles = _excel_styles()

    headers = [
        "Namespace",
        "Resource",
        "Resource Name",
        "Details",
        "Status",
    ]

    resource_order = [
        resource
        for resource in selected_resources
        if resource in {
            "Workloads",
            "Images",
            "ConfigMaps",
            "Secrets",
            "Ingress",
            "Volumes",
            "PVC",
        }
    ]

    missing_rows = []

    for resource in resource_order:
        # Images are compared using the workload/container comparison rows.
        comparison_resource = "Workloads" if resource == "Images" else resource
        rows = comparison.get(comparison_resource, [])

        for row in rows:
            if str(row.get("Status", "")).strip().upper() != "MISSING":
                continue

            namespace = str(row.get("Namespace", "") or "")
            resource_name = ""
            details = ""

            if resource == "Images":
                workload_type = str(row.get("Workload Type", "") or "")
                workload = str(row.get("Workload", "") or "")
                container = str(row.get("Container", "") or "")
                source_image = str(row.get("Source Image", "") or "")

                resource_name = (
                    f"{workload_type}/{workload}"
                    if workload_type and workload
                    else workload
                )
                details = (
                    f"Container: {container} | Image: {source_image}"
                    if container
                    else f"Image: {source_image}"
                )

            elif resource == "Workloads":
                # Workloads are represented only by Deployment name.
                resource_name = str(
                    row.get("Deployment Name", "") or ""
                )
                details = ""

            elif resource == "ConfigMaps":
                resource_name = str(row.get("ConfigMap", "") or "")
                key = str(row.get("Key", "") or "")
                details = f"Key: {key}" if key else ""

            elif resource == "Secrets":
                resource_name = str(row.get("Secret", "") or "")
                key = str(row.get("Key", "") or "")
                details = f"Key: {key}" if key else ""

            elif resource == "Ingress":
                resource_name = str(row.get("Ingress", "") or "")
                parts = []
                for label, field in (
                    ("Host", "Host"),
                    ("Path", "Path"),
                    ("Service", "Service"),
                    ("Port", "Port"),
                ):
                    value = str(row.get(field, "") or "")
                    if value:
                        parts.append(f"{label}: {value}")
                details = " | ".join(parts)

            elif resource == "Volumes":
                resource_name = str(row.get("Volume", "") or "")
                parts = []
                workload_type = str(row.get("Workload Type", "") or "")
                workload = str(row.get("Workload", "") or "")
                volume_type = str(row.get("Volume Type", "") or "")
                mount_paths = str(row.get("Mount Paths", "") or "")

                if workload_type or workload:
                    parts.append(
                        f"Workload: {workload_type}/{workload}".strip("/")
                    )
                if volume_type:
                    parts.append(f"Type: {volume_type}")
                if mount_paths:
                    parts.append(f"Mount: {mount_paths}")

                details = " | ".join(parts)

            elif resource == "PVC":
                resource_name = str(row.get("PVC", "") or "")
                parts = []

                for label, field in (
                    ("Status", "Source Status"),
                    ("Storage Class", "Source Storage Class"),
                    ("Requested Storage", "Source Requested Storage"),
                ):
                    value = str(row.get(field, "") or "")
                    if value:
                        parts.append(f"{label}: {value}")

                details = " | ".join(parts)

            missing_rows.append(
                (
                    namespace,
                    resource,
                    resource_name,
                    details,
                    "MISSING",
                )
            )

    missing_rows.sort(
        key=lambda row: (
            row[0].lower(),
            resource_order.index(row[1]) if row[1] in resource_order else 999,
            row[2].lower(),
            row[3].lower(),
        )
    )

    ws.append(_excel_safe_row(headers))

    for row in missing_rows:
        ws.append(_excel_safe_row(row))

    for cell in ws[1]:
        cell.fill = styles["header_fill"]
        cell.font = styles["header_font"]
        cell.border = styles["border"]
        cell.alignment = Alignment(
            horizontal="center",
            vertical="center",
            wrap_text=True,
        )

    ws.row_dimensions[1].height = 30

    for row_index in range(2, ws.max_row + 1):
        for cell in ws[row_index]:
            cell.border = styles["border"]
            cell.alignment = Alignment(
                vertical="top",
                wrap_text=True,
            )

        if row_index % 2 == 0:
            for cell in ws[row_index]:
                cell.fill = PatternFill(
                    "solid",
                    fgColor="FFFDF2",
                )

        _apply_status(
            ws.cell(row_index, 5),
            ws.cell(row_index, 5).value,
            styles,
        )

    if ws.max_row >= 2:
        ws.auto_filter.ref = ws.dimensions

    ws.freeze_panes = "A2"
    ws.sheet_view.showGridLines = False

    ws.column_dimensions["A"].width = 28
    ws.column_dimensions["B"].width = 18
    ws.column_dimensions["C"].width = 42
    ws.column_dimensions["D"].width = 85
    ws.column_dimensions["E"].width = 20

    ws.sheet_properties.pageSetUpPr.fitToPage = True
    ws.page_setup.orientation = "landscape"
    ws.page_setup.fitToWidth = 1
    ws.page_setup.fitToHeight = 0
    ws.print_title_rows = "1:1"

    return ws


def generate_excel(
    source_env,
    destination_env,
    scope,
    namespace,
    source,
    destination,
    selected_resources=None,
    source_namespaces=None,
    destination_namespaces=None,
):
    selected_resources = list(selected_resources or [
        "Workloads", "Images", "ConfigMaps", "Secrets", "Ingress", "Volumes", "PVC"
    ])

    workbook = openpyxl.Workbook()
    workbook.remove(workbook.active)

    # --------------------------------------------------------
    # BUILD COMPARISON DATA FIRST
    # --------------------------------------------------------
    comparison = {}
    if "Workloads" in selected_resources:
        # Compare ONLY Deployment names. The actual Workloads sheet is created
        # later, after Summary, so the worksheet order is Summary -> Workloads.
        comparison["Workloads"] = _resource_comparison_rows(
            source.get("workloads", []),
            destination.get("workloads", []),
            "Workloads",
        )

    if "Images" in selected_resources:
        comparison["Images"] = _resource_comparison_rows(
            source.get("workloads", []), destination.get("workloads", []), "Images"
        )
    if "ConfigMaps" in selected_resources:
        comparison["ConfigMaps"] = _resource_comparison_rows(
            source.get("configmaps", []), destination.get("configmaps", []), "ConfigMaps"
        )
    if "Secrets" in selected_resources:
        comparison["Secrets"] = _resource_comparison_rows(
            source.get("secrets", []), destination.get("secrets", []), "Secrets"
        )
    if "Ingress" in selected_resources:
        comparison["Ingress"] = _resource_comparison_rows(
            source.get("ingress", []), destination.get("ingress", []), "Ingress"
        )
    if "Volumes" in selected_resources:
        comparison["Volumes"] = _resource_comparison_rows(
            source.get("volumes", []), destination.get("volumes", []), "Volumes"
        )
    if "PVC" in selected_resources:
        comparison["PVC"] = _resource_comparison_rows(
            source.get("pvcs", []), destination.get("pvcs", []), "PVC"
        )

    # Build metrics ONLY for namespaces actually selected/scanned.
    report_namespaces = sorted(
        {str(ns) for ns in (namespace or []) if str(ns).strip()},
        key=str.lower,
    )
    if not report_namespaces:
        # All Namespaces mode: use the complete namespace set from the two
        # connected clusters, not just namespaces that happen to contain a
        # selected resource.
        report_namespaces = sorted(
            {str(ns) for ns in (source_namespaces or []) if str(ns).strip()}
            |
            {str(ns) for ns in (destination_namespaces or []) if str(ns).strip()},
            key=str.lower,
        )

    namespace_metric_rows = _namespace_metrics(
        source, destination, selected_resources, report_namespaces
    )
    # Create Summary first so it is always the first visible worksheet.
    # Formula references to the hidden Namespace Metrics sheet are valid even
    # though that sheet is created immediately afterward.
    _add_resource_summary_sheet(
        workbook,
        source_env,
        destination_env,
        selected_resources,
        report_namespaces,
        namespace_metric_rows,
    )
    _write_namespace_metrics_sheet(workbook, namespace_metric_rows)

    # --------------------------------------------------------
    # DETAIL SHEETS
    # --------------------------------------------------------
    if "Workloads" in selected_resources:
        _add_deployment_comparison_sheet(
            workbook,
            source.get("workloads", []),
            destination.get("workloads", []),
        )

    if "Images" in selected_resources:
        image_rows = []
        for row in comparison.get("Images", []):
            image_rows.append({
                "Namespace": row.get("Namespace", ""),
                "Workload Type": row.get("Workload Type", ""),
                "Workload": row.get("Workload", ""),
                "Container": row.get("Container", ""),
                "Source Image": row.get("Source Image", ""),
                "Destination Image": row.get("Destination Image", ""),
                "Status": row.get("Status", ""),
            })
        add_sheet(workbook, "Images", image_rows)

    if "ConfigMaps" in selected_resources:
        add_key_value_comparison_sheet(
            workbook, "ConfigMaps", source["configmaps"], destination["configmaps"],
            source_env, destination_env, "ConfigMap"
        )

    if "Secrets" in selected_resources:
        add_key_value_comparison_sheet(
            workbook, "Secrets", source["secrets"], destination["secrets"],
            source_env, destination_env, "Secret"
        )

    if "Ingress" in selected_resources:
        add_ingress_comparison_sheet(
            workbook, source["ingress"], destination["ingress"], source_env, destination_env
        )

    if "Volumes" in selected_resources:
        add_sheet(workbook, "Volumes", comparison["Volumes"])

    if "PVC" in selected_resources:
        add_sheet(workbook, "PVC", comparison["PVC"])

    # --------------------------------------------------------
    # MISSING IN DESTINATION
    # --------------------------------------------------------
    # Uses the existing comparison data only. No Kubernetes/API
    # collection logic is changed.
    _add_missing_in_destination_sheet(
        workbook,
        comparison,
        selected_resources,
    )

    # Summary is created first. Do not remove/reinsert worksheets.
    # Summary defaults to ALL SELECTED so multiple namespaces selected in Streamlit are aggregated.

    # Force Excel to recalculate the Summary formulas when the workbook opens.
    try:
        workbook.calculation.fullCalcOnLoad = True
        workbook.calculation.forceFullCalc = True
        workbook.calculation.calcMode = "auto"
    except Exception:
        pass

    output = BytesIO()
    workbook.save(output)
    output.seek(0)
    return output


