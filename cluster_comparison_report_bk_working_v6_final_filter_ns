def _namespace_metrics(source, destination, selected_resources, namespaces):
    """Build metrics strictly for the namespaces that were scanned/selected."""
    specs = {
        "Workloads": ("workloads", "Workloads"),
        "Images": ("workloads", "Images"),
        "ConfigMaps": ("configmaps", "ConfigMaps"),
        "Secrets": ("secrets", "Secrets"),
        "Ingress": ("ingress", "Ingress"),
        "Volumes": ("volumes", "Volumes"),
        "PVC": ("pvcs", "PVC"),
    }
    metrics = []
    selected = sorted({str(ns) for ns in (namespaces or []) if str(ns).strip()}, key=str.lower)

    for namespace in selected:
        for resource in selected_resources:
            if resource not in specs:
                continue
            data_key, compare_resource = specs[resource]
            source_rows = [
                r for r in source.get(data_key, [])
                if str(r.get("Namespace", "")) == namespace
            ]
            destination_rows = [
                r for r in destination.get(data_key, [])
                if str(r.get("Namespace", "")) == namespace
            ]
            compared = _resource_comparison_rows(
                source_rows, destination_rows, compare_resource
            )
            counts = _status_counts(compared)
            metrics.append({
                "Namespace": namespace,
                "Resource": resource,
                "Source Count": len(source_rows),
                "Destination Count": len(destination_rows),
                "Same": counts["SAME"],
                "Different": counts["DIFF"],
                "Missing": counts["MISSING"],
                "Destination Only": counts["DESTINATION ONLY"],
            })
    return metrics

