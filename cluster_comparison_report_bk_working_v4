    ws.merge_cells(
        start_row=2,
        start_column=1,
        end_row=2,
        end_column=total_cols,
    )
    ws["A2"].font = Font(
        italic=True,
        color="666666",
    )
    ws["A2"].alignment = Alignment(
        wrap_text=True,
        vertical="center",
    )
    ws.row_dimensions[2].height = 28

    # ------------------------------------------------------------
    # SOURCE BLOCK
    # ------------------------------------------------------------
    source_title_row = 4
    ws.cell(
        source_title_row,
        1,
        "Source (BLUE)",
    )
    ws.merge_cells(
        start_row=source_title_row,
        start_column=1,
        end_row=source_title_row,
        end_column=len(source_headers),
    )
    ws.cell(
        source_title_row,
        1,
    ).fill = PatternFill(
        "solid",
        fgColor="4472C4",
    )
    ws.cell(
        source_title_row,
        1,
    ).font = Font(
        bold=True,
        color="FFFFFF",
        size=11,
    )
    ws.cell(
        source_title_row,
        1,
    ).border = styles["border"]

    source_header_row = source_title_row + 1
    for col, header in enumerate(
        source_headers,
        start=1,
    ):
        cell = ws.cell(
            source_header_row,
            col,
            header,
        )
        cell.fill = PatternFill(
            "solid",
            fgColor="5B9BD5",
        )
        cell.font = Font(
            bold=True,
            color="FFFFFF",
        )
        cell.border = styles["border"]
        cell.alignment = Alignment(
            horizontal="center",
            vertical="center",
            wrap_text=True,
        )

    for row in rows:
        values = [
            row.get(h, "")
            for h in key_headers
        ] + [
            row.get(h, "")
            for h in source_value_headers
        ]
        ws.append(_excel_safe_row(values))

    source_end = ws.max_row

    # ------------------------------------------------------------
    # DESTINATION BLOCK
    # ------------------------------------------------------------
    dest_title_row = source_end + 2
    ws.cell(
        dest_title_row,
        1,
        "Destination (GREEN)",
    )
    ws.merge_cells(
        start_row=dest_title_row,
        start_column=1,
        end_row=dest_title_row,
        end_column=len(destination_headers),
    )
    ws.cell(
        dest_title_row,
        1,
    ).fill = PatternFill(
        "solid",
        fgColor="70AD47",
    )
    ws.cell(
        dest_title_row,
        1,
    ).font = Font(
        bold=True,
        color="FFFFFF",
        size=11,
    )
    ws.cell(
        dest_title_row,
        1,
    ).border = styles["border"]

    dest_header_row = dest_title_row + 1
    for col, header in enumerate(
        destination_headers,
        start=1,
    ):
        cell = ws.cell(
            dest_header_row,
            col,
            header,
        )
        cell.fill = PatternFill(
            "solid",
            fgColor="70AD47",
        )
        cell.font = Font(
            bold=True,
            color="FFFFFF",
        )
        cell.border = styles["border"]
        cell.alignment = Alignment(
            horizontal="center",
            vertical="center",
            wrap_text=True,
        )

    for row in rows:
        values = [
            row.get(h, "")
            for h in key_headers
        ] + [
            row.get(h, "")
            for h in destination_value_headers
        ] + [
            row.get("Status", "")
        ]

        ws.append(_excel_safe_row(values))

        current_row = ws.max_row
        status = str(
            row.get("Status", "")
        ).upper()

        # Highlight destination values when different.
        if status == "DIFF":
            for dest_col, dest_header in enumerate(
                destination_value_headers,
                start=len(key_headers) + 1,
            ):
                source_header = "Source " + str(
                    dest_header
                )[12:] if str(dest_header).startswith(
                    "Destination "
                ) else None

                if source_header and source_header in row:
                    source_value = row.get(
                        source_header,
                        "",
                    )
                    destination_value = row.get(
                        dest_header,
                        "",
                    )

                    if str(source_value) != str(
                        destination_value
                    ):
                        ws.cell(
                            current_row,
                            dest_col,
                        ).fill = PatternFill(
                            "solid",
                            fgColor="F4CCCC",
                        )

    dest_end = ws.max_row

    # ------------------------------------------------------------
    # FORMATTING
    # ------------------------------------------------------------
    for start_row, end_row, header_row in (
        (
            source_header_row + 1,
            source_end,
            source_header_row,
        ),
        (
            dest_header_row + 1,
            dest_end,
            dest_header_row,
        ),
    ):
        for row_no in range(
            start_row,
            end_row + 1,
        ):
            for cell in ws[row_no]:
                cell.border = styles["border"]
                cell.alignment = Alignment(
                    vertical="top",
                    wrap_text=True,
                )

            if row_no % 2 == 0:
                for cell in ws[row_no]:
                    if not cell.fill.fill_type:
                        cell.fill = PatternFill(
                            "solid",
                            fgColor="F8FBFF",
                        )

    # Status is only in Destination block.
    status_col = len(destination_headers)
    for row_no in range(
        dest_header_row + 1,
        dest_end + 1,
    ):
        _apply_status(
            ws.cell(
                row_no,
                status_col,
            ),
            ws.cell(
                row_no,
                status_col,
            ).value,
            styles,
        )

    # ------------------------------------------------------------
    # REAL EXCEL FILTERS
    # ------------------------------------------------------------
    if source_end >= source_header_row + 1:
        source_table = Table(
            displayName=f"{re.sub(r'[^A-Za-z0-9]', '', name)}SourceTable",
            ref=(
                f"A{source_header_row}:"
                f"{get_column_letter(len(source_headers))}"
                f"{source_end}"
            ),
        )
        source_table.tableStyleInfo = TableStyleInfo(
            name="TableStyleMedium2",
            showFirstColumn=False,
            showLastColumn=False,
            showRowStripes=True,
            showColumnStripes=False,
        )
        ws.add_table(source_table)

    if dest_end >= dest_header_row + 1:
        dest_table = Table(
            displayName=f"{re.sub(r'[^A-Za-z0-9]', '', name)}DestinationTable",
            ref=(
                f"A{dest_header_row}:"
                f"{get_column_letter(len(destination_headers))}"
                f"{dest_end}"
            ),
        )
        dest_table.tableStyleInfo = TableStyleInfo(
            name="TableStyleMedium4",
            showFirstColumn=False,
            showLastColumn=False,
            showRowStripes=True,
            showColumnStripes=False,
        )
        ws.add_table(dest_table)

    # ------------------------------------------------------------
    # SUMMARY CARD
    # ------------------------------------------------------------
    summary_row = dest_end + 3
    counts = _status_counts(rows)

    ws.cell(
        summary_row,
        1,
        f"{name} Summary",
    )
    ws.merge_cells(
        start_row=summary_row,
        start_column=1,
        end_row=summary_row,
        end_column=min(
            total_cols,
            6,
        ),
    )
    ws.cell(
        summary_row,
        1,
    ).fill = PatternFill(
        "solid",
        fgColor="1F4E78",
    )
    ws.cell(
        summary_row,
        1,
    ).font = Font(
        bold=True,
        color="FFFFFF",
        size=11,
    )

    summary_items = [
        ("Total Compared", counts["TOTAL"], "D9EAF7"),
        ("Matching", counts["SAME"], "E2F0D9"),
        ("Different", counts["DIFF"], "FCE4D6"),
        ("Missing", counts["MISSING"], "FFF2CC"),
        ("Destination Only", counts["DESTINATION ONLY"], "DDEBF7"),
    ]

    for index, (label, value, fill) in enumerate(
        summary_items,
        start=1,
    ):
        col = index
        ws.cell(
            summary_row + 1,
            col,
            label,
        )
        ws.cell(
            summary_row + 1,
            col,
        ).fill = PatternFill(
            "solid",
            fgColor="D9EAF7",
        )
        ws.cell(
            summary_row + 1,
            col,
        ).font = Font(
            bold=True,
            color="1F4E78",
        )
        ws.cell(
            summary_row + 1,
            col,
        ).border = styles["border"]

        ws.cell(
            summary_row + 2,
            col,
            value,
        )
        ws.cell(
            summary_row + 2,
            col,
        ).fill = PatternFill(
            "solid",
            fgColor=fill,
        )
        ws.cell(
            summary_row + 2,
            col,
        ).font = Font(
            bold=True,
            size=14,
        )
        ws.cell(
            summary_row + 2,
            col,
        ).alignment = Alignment(
            horizontal="center",
        )
        ws.cell(
            summary_row + 2,
            col,
        ).border = styles["border"]

    # ------------------------------------------------------------
    # WIDTH / PRINT
    # ------------------------------------------------------------
    for index, header in enumerate(
        source_headers,
        start=1,
    ):
        h = str(header).lower()
        width = 24

        if "namespace" in h:
            width = 26
        elif "workload" in h:
            width = 34
        elif "container" in h:
            width = 28
        elif "image" in h:
            width = 58
        elif "configmap" in h or "secret" in h:
            width = 34
        elif "key" in h:
            width = 38
        elif "value" in h:
            width = 58
        elif "volume" in h:
            width = 34
        elif "status" in h:
            width = 22

        ws.column_dimensions[
            get_column_letter(index)
        ].width = width

    for index, header in enumerate(
        destination_headers,
        start=1,
    ):
        current = ws.column_dimensions[
            get_column_letter(index)
        ].width
        ws.column_dimensions[
            get_column_letter(index)
        ].width = max(
            current or 12,
            min(
                58,
                len(str(header)) + 8,
            ),
        )

    ws.freeze_panes = f"A{source_header_row + 1}"
    ws.sheet_view.showGridLines = False
    ws.sheet_view.zoomScale = 90
    ws.sheet_properties.pageSetUpPr.fitToPage = True
    ws.page_setup.orientation = "landscape"
    ws.page_setup.fitToWidth = 1
    ws.page_setup.fitToHeight = 0
    ws.print_title_rows = f"1:{dest_header_row}"

    return ws



def add_key_value_comparison_sheet(
    workbook,
    name,
    source_rows,
    destination_rows,
    source_env,
    destination_env,
    resource_column,
):
    """
    Professional two-block report for ConfigMaps and Secrets.

    Source and Destination have independent Excel filters while each row
    retains Namespace + Resource + Key, making the comparison easy to read.
    """
    if name in workbook.sheetnames:
        del workbook[name]

    ws = workbook.create_sheet(name)
    styles = _excel_styles()

    source_map = {}
    destination_map = {}

    for row in source_rows:
        key = (
            row.get("Namespace", ""),
            row.get(resource_column, ""),
            row.get("Key", ""),
        )
        source_map[key] = row

    for row in destination_rows:
        key = (
            row.get("Namespace", ""),
            row.get(resource_column, ""),
            row.get("Key", ""),
        )
        destination_map[key] = row

    all_keys = sorted(
        set(source_map) | set(destination_map),
        key=lambda x: tuple(
            str(v).lower()
            for v in x
        ),
    )

    title_cols = 5

    ws.cell(
        1,
        1,
        f"{name} Comparison",
    )
    ws.merge_cells(
        start_row=1,
        start_column=1,
        end_row=1,
        end_column=title_cols,
    )
    ws["A1"].fill = PatternFill(
        "solid",
        fgColor="1F4E78",
    )
    ws["A1"].font = Font(
        bold=True,
        color="FFFFFF",
        size=16,
    )
    ws["A1"].border = styles["border"]

    ws.cell(
        2,
        1,
        f"{source_env} vs {destination_env} | "
        "Filter Namespace, resource, key and status.",
    )
    ws.merge_cells(
        start_row=2,
        start_column=1,
        end_row=2,
        end_column=title_cols,
    )
    ws["A2"].font = Font(
        italic=True,
        color="666666",
    )
    ws["A2"].alignment = Alignment(
        wrap_text=True,
    )

    headers = [
        "Namespace",
        resource_column,
        "Key",
        "Value",
        "Status",
    ]

    # ------------------------------------------------------------
    # SOURCE
    # ------------------------------------------------------------
    source_title = 4
    ws.cell(
        source_title,
        1,
        f"Source ({source_env})",
    )
    ws.merge_cells(
        start_row=source_title,
        start_column=1,
        end_row=source_title,
        end_column=4,
    )
    ws.cell(
        source_title,
        1,
    ).fill = PatternFill(
        "solid",
        fgColor="4472C4",
    )
    ws.cell(
        source_title,
        1,
    ).font = Font(
        bold=True,
        color="FFFFFF",
    )

    source_header = 5
    for col, header in enumerate(
        headers[:4],
        start=1,
    ):
        cell = ws.cell(
            source_header,
            col,
            header,
        )
        cell.fill = PatternFill(
            "solid",
            fgColor="5B9BD5",
        )
        cell.font = Font(
            bold=True,
            color="FFFFFF",
        )
        cell.border = styles["border"]
        cell.alignment = Alignment(
            horizontal="center",
            wrap_text=True,
        )

    for key in all_keys:
        row = source_map.get(key)
        if not row:
            continue

        ws.append(
            _excel_safe_row([
                row.get("Namespace", ""),
                row.get(resource_column, ""),
                row.get("Key", ""),
                row.get("Value", ""),
            ])
        )

    source_end = ws.max_row

    # ------------------------------------------------------------
    # DESTINATION
    # ------------------------------------------------------------
    destination_title = source_end + 2
    ws.cell(
        destination_title,
        1,
        f"Destination ({destination_env})",
    )
    ws.merge_cells(
        start_row=destination_title,
        start_column=1,
        end_row=destination_title,
        end_column=5,
    )
    ws.cell(
        destination_title,
        1,
    ).fill = PatternFill(
        "solid",
        fgColor="70AD47",
    )
    ws.cell(
        destination_title,
        1,
    ).font = Font(
        bold=True,
        color="FFFFFF",
    )

    destination_header = destination_title + 1
    for col, header in enumerate(
        headers,
        start=1,
    ):
        cell = ws.cell(
            destination_header,
            col,
            header,
        )
        cell.fill = PatternFill(
            "solid",
            fgColor="70AD47",
        )
        cell.font = Font(
            bold=True,
            color="FFFFFF",
        )
        cell.border = styles["border"]
        cell.alignment = Alignment(
            horizontal="center",
            wrap_text=True,
        )

    for key in all_keys:
        row = destination_map.get(key)
        if not row:
            continue

        source = source_map.get(key)

        if source:
            status = (
                "SAME"
                if str(source.get("Value", "")) ==
                   str(row.get("Value", ""))
                else "DIFF"
            )
        else:
            status = "DESTINATION ONLY"

        ws.append(
            _excel_safe_row([
                row.get("Namespace", ""),
                row.get(resource_column, ""),
                row.get("Key", ""),
                row.get("Value", ""),
                status,
            ])
        )

        current = ws.max_row

        if status == "DIFF":
            ws.cell(
                current,
                4,
            ).fill = PatternFill(
                "solid",
                fgColor="F4CCCC",
            )

    # Add missing source rows to destination block so the comparison
    # remains explicit.
    for key in all_keys:
        if key in source_map and key not in destination_map:
            row = source_map[key]
            ws.append(
                _excel_safe_row([
                    row.get("Namespace", ""),
                    row.get(resource_column, ""),
                    row.get("Key", ""),
                    "missing",
                    "MISSING",
                ])
            )
            ws.cell(
                ws.max_row,
                4,
            ).fill = styles["missing_fill"]

    destination_end = ws.max_row

    # Formatting
    for row_no in range(
        source_header + 1,
        source_end + 1,
    ):
        for cell in ws[row_no]:
            cell.border = styles["border"]
            cell.alignment = Alignment(
                vertical="top",
                wrap_text=True,
            )

    for row_no in range(
        destination_header + 1,
        destination_end + 1,
    ):
        for cell in ws[row_no]:
            cell.border = styles["border"]
            cell.alignment = Alignment(
                vertical="top",
                wrap_text=True,
            )
        _apply_status(
            ws.cell(row_no, 5),
            ws.cell(row_no, 5).value,
            styles,
        )

    # Real filters on both blocks.
    safe_name = re.sub(
        r"[^A-Za-z0-9]",
        "",
        name,
    )

    if source_end >= source_header + 1:
        source_table = Table(
            displayName=f"{safe_name}SourceTable",
            ref=f"A{source_header}:D{source_end}",
        )
        source_table.tableStyleInfo = TableStyleInfo(
            name="TableStyleMedium2",
            showRowStripes=True,
            showColumnStripes=False,
        )
        ws.add_table(source_table)

    if destination_end >= destination_header + 1:
        destination_table = Table(
            displayName=f"{safe_name}DestinationTable",
            ref=f"A{destination_header}:E{destination_end}",
        )
        destination_table.tableStyleInfo = TableStyleInfo(
            name="TableStyleMedium4",
            showRowStripes=True,
            showColumnStripes=False,
        )
        ws.add_table(destination_table)

    # Summary
    summary_row = destination_end + 3
    counts = _status_counts(
        _resource_comparison_rows(
            source_rows,
            destination_rows,
            "ConfigMaps" if name == "ConfigMaps" else "Secrets",
        )
    )

    ws.cell(
        summary_row,
        1,
        f"{name} Summary",
    )
    ws.merge_cells(
        start_row=summary_row,
        start_column=1,
        end_row=summary_row,
        end_column=5,
    )
    ws.cell(
        summary_row,
        1,
    ).fill = PatternFill(
        "solid",
        fgColor="1F4E78",
    )
    ws.cell(
        summary_row,
        1,
    ).font = Font(
        bold=True,
        color="FFFFFF",
    )

    summary_items = [
        ("Total", counts["TOTAL"], "D9EAF7"),
        ("Same", counts["SAME"], "E2F0D9"),
        ("Different", counts["DIFF"], "FCE4D6"),
        ("Missing", counts["MISSING"], "FFF2CC"),
        ("Destination Only", counts["DESTINATION ONLY"], "DDEBF7"),
    ]

    for col, (label, value, fill) in enumerate(
        summary_items,
        start=1,
    ):
        ws.cell(
            summary_row + 1,
            col,
            label,
        )
        ws.cell(
            summary_row + 1,
            col,
        ).fill = PatternFill(
            "solid",
            fgColor="D9EAF7",
        )
        ws.cell(
            summary_row + 1,
            col,
        ).font = Font(
            bold=True,
            color="1F4E78",
        )
        ws.cell(
            summary_row + 1,
            col,
        ).border = styles["border"]

        ws.cell(
            summary_row + 2,
            col,
            value,
        )
        ws.cell(
            summary_row + 2,
            col,
        ).fill = PatternFill(
            "solid",
            fgColor=fill,
        )
        ws.cell(
            summary_row + 2,
            col,
        ).font = Font(
            bold=True,
            size=14,
        )
        ws.cell(
            summary_row + 2,
            col,
        ).alignment = Alignment(
            horizontal="center",
        )
        ws.cell(
            summary_row + 2,
            col,
        ).border = styles["border"]

    widths = [26, 34, 38, 65, 24]
    for index, width in enumerate(
        widths,
        start=1,
    ):
        ws.column_dimensions[
            get_column_letter(index)
        ].width = width

    ws.freeze_panes = f"A{source_header + 1}"
    ws.sheet_view.showGridLines = False
    ws.sheet_view.zoomScale = 90
    ws.sheet_properties.pageSetUpPr.fitToPage = True
    ws.page_setup.orientation = "landscape"
    ws.page_setup.fitToWidth = 1
    ws.page_setup.fitToHeight = 0
    ws.print_title_rows = f"1:{destination_header}"

    return ws



def add_ingress_comparison_sheet(
    workbook,
    source_rows,
    destination_rows,
    source_env,
    destination_env,
):
    """Create a clean, filterable two-block Ingress comparison sheet.

    This keeps the existing comparison/collection logic unchanged.  It only
    improves the Excel presentation by adding independent filters to the
    Source and Destination blocks plus a compact comparison summary.
    """
    ws = workbook.create_sheet("Ingress")
    styles = _excel_styles()

    headers = [
        "Namespace", "Ingress", "Host", "Path", "Service", "Destination Port", "Status"
    ]

    # Match rows using the same existing comparison key.
    def key(row):
        return (
            row.get("Namespace", ""),
            row.get("Ingress", ""),
            row.get("Path", ""),
            row.get("Service", ""),
            str(row.get("Port", "")),
        )

    source_map = {key(r): r for r in source_rows}
    destination_map = {key(r): r for r in destination_rows}
    all_keys = sorted(
        set(source_map) | set(destination_map),
        key=lambda x: tuple(str(v).lower() for v in x),
    )

    # --------------------------------------------------------
    # TITLE
    # --------------------------------------------------------
    ws.append(["Ingress Comparison"])
    ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=7)
    title = ws.cell(1, 1)
    title.fill = styles["header_fill"]
    title.font = Font(bold=True, size=14, color="FFFFFF")
    title.alignment = Alignment(horizontal="left", vertical="center")
    title.border = styles["border"]
    ws.row_dimensions[1].height = 30

