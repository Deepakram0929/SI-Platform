def _add_namespace_dropdown(workbook, namespaces, summary_cell="F5"):
    """
    Add the Summary Namespace Filter dropdown.

    This helper only creates the hidden Lists sheet and Excel validation.
    It deliberately does NOT write/merge/style any Summary cells.

    This is important because the Summary dashboard owns its own layout.
    Keeping layout code here caused the previous MergedCell read-only error.
    """
    if "Summary" not in workbook.sheetnames:
        return

    values = sorted(
        {
            str(n).strip()
            for n in (namespaces or [])
            if str(n).strip()
        },
        key=str.lower,
    )

    if not values:
        return

    if "Lists" in workbook.sheetnames:
        lists_ws = workbook["Lists"]
        if lists_ws.max_row > 0:
            lists_ws.delete_rows(
                1,
                lists_ws.max_row,
            )
    else:
        lists_ws = workbook.create_sheet("Lists")

    lists_ws.sheet_state = "hidden"

    lists_ws["A1"] = "ALL SELECTED"

    for idx, namespace in enumerate(
        values,
        start=2,
    ):
        lists_ws.cell(
            idx,
            1,
            namespace,
        )

    last_row = len(values) + 1

    validation = DataValidation(
        type="list",
        formula1=f"='Lists'!$A$1:$A${last_row}",
        allow_blank=False,
    )

    validation.error = (
        "Select a namespace from the list."
    )
    validation.errorTitle = "Invalid namespace"
    validation.prompt = (
        "Select one of the namespaces included "
        "in this report."
    )
    validation.promptTitle = "Namespace Filter"

    summary = workbook["Summary"]

    summary.add_data_validation(
        validation
    )
    validation.add(
        summary[summary_cell]
    )



