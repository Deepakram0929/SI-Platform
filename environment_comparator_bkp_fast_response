def get_namespaces(api):

    response = api.list_namespace(
        _request_timeout=KUBE_API_TIMEOUT
    )

    names = []

    for item in response.items or []:

        if (
            item.metadata
            and item.metadata.name
        ):

            names.append(
                item.metadata.name
            )

    return sorted(
        set(names),
        key=str.lower,
    )


