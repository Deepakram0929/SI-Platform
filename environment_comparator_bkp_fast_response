def update_selected_resource(
    resource_type,
    api,
    namespace,
    source_resources,
    selected,
):

    if not selected:
        return

    st.markdown("### 🚀 Update Destination")

    total = sum(len(keys) for keys in selected.values())

    st.success(
        f"{total} {resource_type} key(s) selected for destination update."
    )

    # Use ONE dataframe for the preview instead of creating many st.code/st.columns
    # widgets. This is critical when Select All contains hundreds of keys.
    preview_rows = []
    for name, keys in selected.items():
        source_data = source_resources.get(name, {})
        for key in keys:
            preview_rows.append({
                "Resource": name,
                "Key": key,
                "Source Value": normalize_value(source_data.get(key, "")),
            })

    if preview_rows:
        st.dataframe(
            pd.DataFrame(preview_rows),
            hide_index=True,
            use_container_width=True,
            height=min(500, max(120, 45 + len(preview_rows) * 35)),
        )

    confirm_key = f"ec_confirm_{resource_type}"
    confirm = st.checkbox(
        f"I confirm that the selected {resource_type} source values should "
        "be updated in the destination.",
        key=confirm_key,
    )

    if not confirm:
        return

    button_key = f"ec_update_{resource_type}"

    if st.button(
        f"🚀 Update Selected {resource_type} Keys",
        type="primary",
        use_container_width=True,
        key=button_key,
    ):

        success = 0
        failed = 0

        for name, keys in selected.items():
            source_data = source_resources.get(name, {})

            if resource_type == "ConfigMap":
                ok, message = patch_configmap(
                    api, namespace, name, source_data, keys
                )
            elif resource_type == "Secret":
                ok, message = patch_secret(
                    api, namespace, name, source_data, keys
                )
            else:
                ok = False
                message = f"{resource_type} updates are disabled."

            if ok:
                success += 1
            else:
                failed += 1

        if failed == 0:
            st.success(
                f"All selected {resource_type} values were updated successfully."
            )
        else:
            st.warning(
                f"Update completed. Successful: {success}. Failed: {failed}."
            )


