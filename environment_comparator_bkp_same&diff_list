def resource_title(
    resource_type,
    namespace,
    item,
):

    status = item[
        "resource_status"
    ]

    if status == "MISSING":

        icon = "🟡"

    elif status == "DESTINATION_ONLY":

        icon = "🔵"

    else:

        icon = "🟠"

    return (
        f"{icon} "
        f"{status.replace('_', ' ')} | "
        f"{namespace} | "
        f"{resource_type} | "
        f"{item['name']} | "
        f"{len(item['fields'])} field(s)"
    )


# ============================================================
# RENDER KEY/VALUE RESOURCE
# ============================================================

def render_key_value_resource(
    resource_type,
    namespace,
    item,
):

    name = item[
        "name"
    ]

    destination_exists = item[
        "destination_exists"
    ]

    with st.expander(
        resource_title(
            resource_type,
            namespace,
            item,
        ),
        expanded=False,
    ):

        if (
            item[
                "resource_status"
            ]
            == "MISSING"
        ):

            st.warning(
                f"This {resource_type} exists in "
                "the source cluster but does not "
                "exist in the destination. "
                "It will NOT be created automatically."
            )

        elif (
            item[
                "resource_status"
            ]
            == "DESTINATION_ONLY"
        ):

            st.info(
                f"This {resource_type} exists only "
                "in the destination cluster. "
                "It will NOT be deleted."
            )

        st.caption(
            f"All {resource_type} keys from both "
            "clusters are displayed."
        )

        header = st.columns(
            [
                0.05,
                0.25,
                0.30,
                0.30,
                0.10,
            ]
        )

        with header[0]:

            st.markdown(
                "**✓**"
            )

        with header[1]:

            st.markdown(
                "**Key / Field**"
            )

        with header[2]:

            st.markdown(
                "**Source Value**"
            )

        with header[3]:

            st.markdown(
                "**Destination Value**"
            )

        with header[4]:

            st.markdown(
                "**Status**"
            )

        st.divider()

        for index, field in enumerate(
            item["fields"]
        ):

            row = st.columns(
                [
                    0.05,
                    0.25,
                    0.30,
                    0.30,
                    0.10,
                ]
            )

            key = field[
                "key"
            ]

            status = field[
                "status"
            ]

            # ------------------------------------------------
            # SELECT
            # ------------------------------------------------

            with row[0]:

                can_update = (
                    resource_type
                    in (
                        "ConfigMap",
                        "Secret",
                    )
                    and destination_exists
                    and status
                    in (
                        "DIFF",
                        "MISSING",
                    )
                )

                if can_update:

                    checkbox_key = (
                        f"ec_select_"
                        f"{resource_type}_"
                        f"{namespace}_"
                        f"{name}_"
                        f"{index}"
                    )

                    st.checkbox(
                        "Select",
                        key=checkbox_key,
                        label_visibility="collapsed",
                    )

                else:

                    st.write("")

            # ------------------------------------------------
            # KEY
            # ------------------------------------------------

            with row[1]:

                st.markdown(
                    f"""
                    <div class="key-box">
                        {safe_text(key)}
                    </div>
                    """,
                    unsafe_allow_html=True,
                )

            # ------------------------------------------------
            # SOURCE
            # ------------------------------------------------

            with row[2]:

                render_value_box(
                    field[
                        "source_value"
                    ],
                    "source-value",
                )

            # ------------------------------------------------
            # DESTINATION
            # ------------------------------------------------

            with row[3]:

                render_value_box(
                    field[
                        "destination_value"
                    ],
                    "destination-value",
                )

            # ------------------------------------------------
            # STATUS
            # ------------------------------------------------

            with row[4]:

                render_status(
                    status
                )


# ============================================================
# GET SELECTED RESOURCE KEYS
# ============================================================

def get_selected_keys(
    resource_type,
    namespace,
    results,
):

    selected = {}

    if resource_type not in (
        "ConfigMap",
        "Secret",
    ):

        return selected

    for item in results:

        if not item[
            "destination_exists"
        ]:

            continue

        name = item[
            "name"
        ]

        for index, field in enumerate(
            item["fields"]
        ):

            if field[
                "status"
            ] not in (
                "DIFF",
                "MISSING",
            ):

                continue

            checkbox_key = (
                f"ec_select_"
                f"{resource_type}_"
                f"{namespace}_"
                f"{name}_"
                f"{index}"
            )

            if st.session_state.get(
                checkbox_key,
                False,
            ):

                selected.setdefault(
                    name,
                    [],
                ).append(
                    field["key"]
                )

    return selected


# ============================================================
# UPDATE SELECTED RESOURCE
# ============================================================

def update_selected_resource(
    resource_type,
    api,
    namespace,
    source_resources,
    selected,
):

    if not selected:

        return

    st.markdown(
        "### 🚀 Update Destination"
    )

    total = sum(
        len(keys)
        for keys in selected.values()
    )

    st.success(
        f"{total} {resource_type} key(s) "
        "selected for destination update."
    )

    # --------------------------------------------------------
    # PREVIEW
    # --------------------------------------------------------

    for name, keys in (
        selected.items()
    ):

        st.markdown(
            f"#### {resource_type}: `{name}`"
        )

        source_data = source_resources.get(
            name,
            {},
        )

        for key in keys:

            col1, col2 = st.columns(
                [
                    0.30,
                    0.70,
                ]
            )

            with col1:

                st.code(
                    key,
                    language=None,
                )

            with col2:

                st.code(
                    normalize_value(
                        source_data.get(
                            key,
                            "",
                        )
                    ),
                    language=None,
                )

    confirm_key = (
        f"ec_confirm_"
        f"{resource_type}"
    )

    confirm = st.checkbox(
        f"I confirm that the selected "
        f"{resource_type} source values should "
        "be updated in the destination.",
        key=confirm_key,
    )

    if not confirm:

        return

    button_key = (
        f"ec_update_"
        f"{resource_type}"
    )

    if st.button(
        f"🚀 Update Selected {resource_type} Keys",
        type="primary",
        use_container_width=True,
        key=button_key,
    ):

        success = 0
        failed = 0

        for name, keys in (
            selected.items()
        ):

            source_data = (
                source_resources.get(
                    name,
                    {},
                )
            )

            if resource_type == "ConfigMap":

                ok, message = (
                    patch_configmap(
                        api,
                        namespace,
                        name,
                        source_data,
                        keys,
                    )
                )

            elif resource_type == "Secret":

                ok, message = (
                    patch_secret(
                        api,
                        namespace,
                        name,
                        source_data,
                        keys,
                    )
                )

            else:

                ok = False

                message = (
                    f"{resource_type} "
                    "updates are disabled."
                )

            if ok:

                success += 1

                st.success(
                    f"{name}: {message}"
                )

            else:

                failed += 1

                st.error(
                    f"{name}: {message}"
                )

        if failed == 0:

            st.success(
                f"All selected {resource_type} "
                "values were updated successfully."
            )

        else:

            st.warning(
                f"Update completed. "
                f"Successful: {success}. "
                f"Failed: {failed}."
            )


