def get_namespaces(api):

    response = api.list_namespace(
        _request_timeout=60
    )

    names = []

    for item in response.items or []:

        if (
            item.metadata
            and item.metadata.name
        ):

            names.append(
                item.metadata.name
            )

    return sorted(
        set(names),
        key=str.lower,
    )


