            "🔄 Refresh Namespace List",
            use_container_width=True,
            key="ec_refresh_button",
        )

    # ========================================================
    # CONNECT ACTION
    # ========================================================

    if connect:

        if (
            source_file is None
            or destination_file is None
        ):

